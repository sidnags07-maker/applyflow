# API keys for the draft backends. Copy to .env (git-ignored).
#
#   cp .env.example .env
#
# Both are optional: with neither set, drafting falls back to the
# offline template backend and costs nothing.

# Gemini (free tier): https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Claude (paid, higher quality + web search per draft): https://console.anthropic.com
# ANTHROPIC_API_KEY=
